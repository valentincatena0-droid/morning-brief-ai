# Copy to .env for LOCAL runs only. Never commit .env. In production use GitHub Actions secrets.

# ntfy topic = your private "channel" (treat it like a password). Generate with: python scripts/init_secrets.py
NTFY_TOPIC=

# Optional: access token if you use a reserved/protected ntfy topic (leave empty for public ntfy.sh topics)
NTFY_TOKEN=

# Public URL of your installed PWA (GitHub Pages), used as the notification tap target. Not a secret.
APP_URL=https://YOUR-USER.github.io/morning-brief-ai/

# Optional (free tier): enables grounded EXPLAIN blocks / translation. Leave empty for pure-extractive mode.
GEMINI_API_KEY=
